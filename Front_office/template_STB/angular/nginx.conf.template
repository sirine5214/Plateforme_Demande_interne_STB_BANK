server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Application Angular : toute route inconnue retombe sur index.html (routing côté client)
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location = /favicon.ico { access_log off; log_not_found off; }

    # API REST du Back_office
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Fichiers uploadés (avatars, pièces jointes)
    location /uploads/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/uploads/;
        proxy_set_header Host $host;
    }

    # Notifications temps réel (WebSocket)
    location /ws/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
