{
  "title": "STB Bank - Back Office (Spring Boot)",
  "uid": "stb-back-office",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Statut du service",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"stb-back-office\"}", "legendFormat": "up" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Uptime",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "process_uptime_seconds{job=\"stb-back-office\"}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "title": "Connexions actives HikariCP",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "hikaricp_connections_active{job=\"stb-back-office\"}" }]
    },
    {
      "id": 4,
      "title": "Threads JVM",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "jvm_threads_live_threads{job=\"stb-back-office\"}" }]
    },
    {
      "id": 5,
      "title": "Débit de requêtes HTTP (req/s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"stb-back-office\"}[1m])) by (uri, status)",
          "legendFormat": "{{uri}} [{{status}}]"
        }
      ]
    },
    {
      "id": 6,
      "title": "Latence HTTP p95 (s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"stb-back-office\"}[5m])) by (le, uri))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Taux d'erreurs HTTP 5xx",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"stb-back-office\", status=~\"5..\"}[5m]))",
          "legendFormat": "erreurs 5xx / s"
        }
      ]
    },
    {
      "id": 8,
      "title": "Mémoire JVM utilisée (heap)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"stb-back-office\", area=\"heap\"}) by (id)",
          "legendFormat": "{{id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 9,
      "title": "CPU process (%)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "process_cpu_usage{job=\"stb-back-office\"} * 100", "legendFormat": "process" },
        { "expr": "system_cpu_usage{job=\"stb-back-office\"} * 100", "legendFormat": "system" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    }
  ]
}
