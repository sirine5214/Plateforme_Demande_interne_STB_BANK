# Copier ce fichier en ".env" puis ajuster les valeurs avant de lancer docker-compose.
# ".env" est ignoré par git (voir .gitignore) : n'y placez jamais de vrai secret versionné.

# --- PostgreSQL ---
POSTGRES_DB=stb_bank
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Backend (Spring Boot) ---
JWT_SECRET=change-me-generate-a-long-random-base64-string
JWT_EXPIRATION_MS=86400000
BACKEND_PORT=8080

# --- Frontend ---
FRONTEND_PORT=4200

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Prometheus ---
PROMETHEUS_PORT=9090
